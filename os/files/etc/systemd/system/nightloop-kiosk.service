[Unit]
Description=NIGHTLOOP screen
After=nightloop.service systemd-user-sessions.service plymouth-quit-wait.service seatd.service
Wants=nightloop.service
Conflicts=getty@tty1.service

[Service]
User=nightloop
PAMName=login
TTYPath=/dev/tty1
StandardInput=tty
StandardOutput=journal
StandardError=journal
UtmpIdentifier=tty1
Environment=XDG_SESSION_TYPE=wayland
ExecStart=/opt/nightloop/kiosk.sh
Restart=always
RestartSec=3

[Install]
WantedBy=graphical.target
