[Unit]
Description=NIGHTLOOP simulator
After=network-online.target nightloop-firstboot.service
Wants=network-online.target

[Service]
User=nightloop
WorkingDirectory=/opt/nightloop/app
Environment=NIGHTLOOP_NO_BROWSER=1
ExecStart=/usr/bin/python3 /opt/nightloop/app/server.py
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
