{
  "version": 8,
  "name": "NIGHTLOOP Dark map test",
  "sources": {
    "omt": { "type": "vector", "url": "https://tiles.openfreemap.org/planet",
             "attribution": "<a href=\"https://openfreemap.org\" target=\"_blank\">OpenFreeMap</a> &copy; OpenMapTiles Data from &copy; OpenStreetMap" }
  },
  "glyphs": "https://tiles.openfreemap.org/fonts/{fontstack}/{range}.pbf",
  "layers": [
    { "id": "bg", "type": "background", "paint": { "background-color": "#0a0f16" } },
    { "id": "landcover", "type": "fill", "source": "omt", "source-layer": "landcover",
      "filter": ["match", ["get", "class"], ["wood", "grass", "farmland", "wetland"], true, false],
      "paint": { "fill-color": "#0d1611", "fill-opacity": 0.55 } },
    { "id": "landuse-urban", "type": "fill", "source": "omt", "source-layer": "landuse", "minzoom": 6,
      "filter": ["match", ["get", "class"], ["residential", "commercial", "industrial", "retail"], true, false],
      "paint": { "fill-color": "#141a25", "fill-opacity": 0.8 } },
    { "id": "park", "type": "fill", "source": "omt", "source-layer": "park",
      "paint": { "fill-color": "#0f1c17", "fill-opacity": 0.6 } },
    { "id": "water", "type": "fill", "source": "omt", "source-layer": "water",
      "paint": { "fill-color": "#0c2233", "fill-outline-color": "#2a5f80" } },
    { "id": "water-outline", "type": "line", "source": "omt", "source-layer": "water",
      "paint": { "line-color": "#2f6a8e", "line-width": ["interpolate", ["linear"], ["zoom"], 2, 0.4, 8, 0.9, 14, 1.4], "line-opacity": 0.85 } },
    { "id": "waterway", "type": "line", "source": "omt", "source-layer": "waterway", "minzoom": 6,
      "paint": { "line-color": "#1d4a66", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 14, 2] } },
    { "id": "aerodrome-area", "type": "fill", "source": "omt", "source-layer": "aeroway", "minzoom": 9,
      "filter": ["==", ["geometry-type"], "Polygon"],
      "paint": { "fill-color": "#18212e", "fill-opacity": 0.9 } },
    { "id": "taxiway", "type": "line", "source": "omt", "source-layer": "aeroway", "minzoom": 11,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "taxiway"]],
      "paint": { "line-color": "#46596a", "line-width": ["interpolate", ["exponential", 2], ["zoom"], 11, 0.5, 16, 8] } },
    { "id": "runway", "type": "line", "source": "omt", "source-layer": "aeroway", "minzoom": 9,
      "filter": ["all", ["==", ["geometry-type"], "LineString"], ["==", ["get", "class"], "runway"]],
      "paint": { "line-color": "#8aa2b5", "line-width": ["interpolate", ["exponential", 2], ["zoom"], 9, 1, 16, 30] } },
    { "id": "road-minor", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 11,
      "filter": ["match", ["get", "class"], ["minor", "service", "tertiary"], true, false],
      "paint": { "line-color": "#1d2531", "line-width": ["interpolate", ["linear"], ["zoom"], 11, 0.4, 16, 3] } },
    { "id": "road-major", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 6,
      "filter": ["match", ["get", "class"], ["primary", "secondary", "trunk"], true, false],
      "paint": { "line-color": "#2a3544", "line-width": ["interpolate", ["linear"], ["zoom"], 6, 0.4, 16, 5] } },
    { "id": "road-motorway", "type": "line", "source": "omt", "source-layer": "transportation", "minzoom": 5,
      "filter": ["==", ["get", "class"], "motorway"],
      "paint": { "line-color": "#36475a", "line-width": ["interpolate", ["linear"], ["zoom"], 5, 0.5, 16, 7] } },
    { "id": "building", "type": "fill", "source": "omt", "source-layer": "building", "minzoom": 14,
      "paint": { "fill-color": "#171e2a", "fill-outline-color": "#232d3c" } },
    { "id": "boundary-state", "type": "line", "source": "omt", "source-layer": "boundary", "minzoom": 3,
      "filter": ["all", ["==", ["get", "admin_level"], 4], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#3e4c5e", "line-width": ["interpolate", ["linear"], ["zoom"], 3, 0.4, 10, 1.2], "line-dasharray": [3, 2] } },
    { "id": "boundary-country", "type": "line", "source": "omt", "source-layer": "boundary",
      "filter": ["all", ["==", ["get", "admin_level"], 2], ["!=", ["get", "maritime"], 1]],
      "paint": { "line-color": "#8195ab", "line-width": ["interpolate", ["linear"], ["zoom"], 1, 0.6, 6, 1.4, 12, 2.2] } },
    { "id": "water-name", "type": "symbol", "source": "omt", "source-layer": "water_name",
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Italic"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 8, 13], "text-letter-spacing": 0.1, "text-max-width": 8 },
      "paint": { "text-color": "#4f7d9c", "text-halo-color": "#0a0f16", "text-halo-width": 1 } },
    { "id": "place-city", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 4,
      "filter": ["match", ["get", "class"], ["city", "town"], true, false],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 4, 10, 10, 14], "text-max-width": 8 },
      "paint": { "text-color": "#a9b8c8", "text-halo-color": "#0a0f16", "text-halo-width": 1.2 } },
    { "id": "place-state", "type": "symbol", "source": "omt", "source-layer": "place", "minzoom": 4, "maxzoom": 8,
      "filter": ["==", ["get", "class"], "state"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Regular"],
                  "text-size": 11, "text-transform": "uppercase", "text-letter-spacing": 0.15 },
      "paint": { "text-color": "#5f6f82", "text-halo-color": "#0a0f16", "text-halo-width": 1 } },
    { "id": "place-country", "type": "symbol", "source": "omt", "source-layer": "place", "maxzoom": 8,
      "filter": ["==", ["get", "class"], "country"],
      "layout": { "text-field": ["coalesce", ["get", "name:en"], ["get", "name"]], "text-font": ["Noto Sans Bold"],
                  "text-size": ["interpolate", ["linear"], ["zoom"], 1, 10, 6, 15], "text-transform": "uppercase",
                  "text-letter-spacing": 0.12, "text-max-width": 8 },
      "paint": { "text-color": "#c4d1de", "text-halo-color": "#0a0f16", "text-halo-width": 1.5 } }
  ]
}
